+def test_partner_empty_not_conflated_with_network_or_demo():
+    class Client:
+        def search_slots(self,**kwargs): return dict(status='SUCCESS',slots=[])
+    out=cp.PartnerCareSearchProvider(Client()).search_slots('Dermatoloji')
