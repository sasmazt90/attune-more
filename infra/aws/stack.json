{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Task 13 preparation. No DNS or automatic shutdown. Creating this stack incurs charges.",
  "Parameters": {
    "Owner": {
      "Type": "String",
      "MinLength": 1
    },
    "AvailabilityZone": {
      "Type": "AWS::EC2::AvailabilityZone::Name"
    },
    "WebAmi": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Verified Frankfurt x86_64 Ubuntu 24.04 /dev/sda1 AMI"
    },
    "AaosAmi": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Verified Frankfurt x86_64 Ubuntu 24.04 /dev/sda1 AMI"
    },
    "DemoClientCidr": {
      "Type": "String",
      "AllowedPattern": "(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}",
      "Description": "Review the client IPv4 CIDR; 0.0.0.0/0 is possible only behind TLS and authentication"
    },
    "BudgetEmail": {
      "Type": "String",
      "AllowedPattern": ".+@.+\\..+"
    },
    "MonthlyBudgetUsd": {
      "Type": "Number",
      "MinValue": 1
    }
  },
  "Rules": {
    "FrankfurtOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-central-1"
            ]
          },
          "AssertDescription": "Only Frankfurt is authorized for this task"
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.83.0.0/24",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.83.0.0/25",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "WebSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS only; internal mTLS peer rule added separately",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "DemoClientCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "AaosSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS only; internal mTLS peer rule added separately",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "DemoClientCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "PrivateApiIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "WebSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8443,
        "ToPort": 8443,
        "SourceSecurityGroupId": {
          "Ref": "AaosSecurity"
        }
      }
    },
    "PrivateApiEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "AaosSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8443,
        "ToPort": 8443,
        "DestinationSecurityGroupId": {
          "Ref": "WebSecurity"
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "WebTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "WebAmi"
          },
          "InstanceType": "g6.2xlarge",
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": [
                "HostProfile",
                "Arn"
              ]
            }
          },
          "SecurityGroupIds": [
            {
              "Ref": "WebSecurity"
            }
          ],
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpEndpoint": "enabled",
            "HttpPutResponseHopLimit": 1
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/sda1",
              "Ebs": {
                "VolumeSize": 150,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Attune.more"
                },
                {
                  "Key": "Task",
                  "Value": "13"
                },
                {
                  "Key": "Owner",
                  "Value": {
                    "Ref": "Owner"
                  }
                },
                {
                  "Key": "Environment",
                  "Value": "oem-demo"
                },
                {
                  "Key": "CostCenter",
                  "Value": "attune-oem"
                },
                {
                  "Key": "Role",
                  "Value": "web"
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Attune.more"
                },
                {
                  "Key": "Task",
                  "Value": "13"
                },
                {
                  "Key": "Owner",
                  "Value": {
                    "Ref": "Owner"
                  }
                },
                {
                  "Key": "Environment",
                  "Value": "oem-demo"
                },
                {
                  "Key": "CostCenter",
                  "Value": "attune-oem"
                },
                {
                  "Key": "Role",
                  "Value": "web"
                }
              ]
            }
          ]
        },
        "TagSpecifications": [
          {
            "ResourceType": "launch-template",
            "Tags": [
              {
                "Key": "Project",
                "Value": "Attune.more"
              },
              {
                "Key": "Task",
                "Value": "13"
              },
              {
                "Key": "Owner",
                "Value": {
                  "Ref": "Owner"
                }
              },
              {
                "Key": "Environment",
                "Value": "oem-demo"
              },
              {
                "Key": "CostCenter",
                "Value": "attune-oem"
              }
            ]
          }
        ]
      }
    },
    "WebInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "WebTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "WebTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      },
      "DependsOn": "InternetRoute"
    },
    "WebAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "WebAddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "WebAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "WebInstance"
        }
      }
    },
    "AaosTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "ImageId": {
            "Ref": "AaosAmi"
          },
          "InstanceType": "m8i.2xlarge",
          "IamInstanceProfile": {
            "Arn": {
              "Fn::GetAtt": [
                "HostProfile",
                "Arn"
              ]
            }
          },
          "SecurityGroupIds": [
            {
              "Ref": "AaosSecurity"
            }
          ],
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpEndpoint": "enabled",
            "HttpPutResponseHopLimit": 1
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/sda1",
              "Ebs": {
                "VolumeSize": 100,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Attune.more"
                },
                {
                  "Key": "Task",
                  "Value": "13"
                },
                {
                  "Key": "Owner",
                  "Value": {
                    "Ref": "Owner"
                  }
                },
                {
                  "Key": "Environment",
                  "Value": "oem-demo"
                },
                {
                  "Key": "CostCenter",
                  "Value": "attune-oem"
                },
                {
                  "Key": "Role",
                  "Value": "aaos"
                }
              ]
            },
            {
              "ResourceType": "volume",
              "Tags": [
                {
                  "Key": "Project",
                  "Value": "Attune.more"
                },
                {
                  "Key": "Task",
                  "Value": "13"
                },
                {
                  "Key": "Owner",
                  "Value": {
                    "Ref": "Owner"
                  }
                },
                {
                  "Key": "Environment",
                  "Value": "oem-demo"
                },
                {
                  "Key": "CostCenter",
                  "Value": "attune-oem"
                },
                {
                  "Key": "Role",
                  "Value": "aaos"
                }
              ]
            }
          ],
          "CpuOptions": {
            "NestedVirtualization": "enabled"
          }
        },
        "TagSpecifications": [
          {
            "ResourceType": "launch-template",
            "Tags": [
              {
                "Key": "Project",
                "Value": "Attune.more"
              },
              {
                "Key": "Task",
                "Value": "13"
              },
              {
                "Key": "Owner",
                "Value": {
                  "Ref": "Owner"
                }
              },
              {
                "Key": "Environment",
                "Value": "oem-demo"
              },
              {
                "Key": "CostCenter",
                "Value": "attune-oem"
              }
            ]
          }
        ]
      }
    },
    "AaosInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "AaosTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "AaosTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "SubnetId": {
          "Ref": "Subnet"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      },
      "DependsOn": "InternetRoute"
    },
    "AaosAddress": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Attune.more"
          },
          {
            "Key": "Task",
            "Value": "13"
          },
          {
            "Key": "Owner",
            "Value": {
              "Ref": "Owner"
            }
          },
          {
            "Key": "Environment",
            "Value": "oem-demo"
          },
          {
            "Key": "CostCenter",
            "Value": "attune-oem"
          }
        ]
      }
    },
    "AaosAddressAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "AaosAddress",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "AaosInstance"
        }
      }
    },
    "DemoBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": {
            "Fn::Sub": "${AWS::StackName}-monthly"
          },
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUsd"
            },
            "Unit": "USD"
          },
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY"
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 50,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "FORECASTED",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "WebInstanceId": {
      "Value": {
        "Ref": "WebInstance"
      }
    },
    "WebPublicIp": {
      "Value": {
        "Ref": "WebAddress"
      }
    },
    "WebPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "WebInstance",
          "PrivateIp"
        ]
      }
    },
    "AaosInstanceId": {
      "Value": {
        "Ref": "AaosInstance"
      }
    },
    "AaosPublicIp": {
      "Value": {
        "Ref": "AaosAddress"
      }
    },
    "AaosPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "AaosInstance",
          "PrivateIp"
        ]
      }
    }
  }
}
