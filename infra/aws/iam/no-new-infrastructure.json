{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverProvisionReplacementInfrastructure",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:RequestSpotInstances",
        "ec2:RequestSpotFleet",
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateVolume",
        "ec2:CreateSecurityGroup",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateNatGateway",
        "ec2:CreateInternetGateway",
        "ec2:AllocateAddress",
        "ec2:TerminateInstances"
      ],
      "Resource": "*"
    }
  ]
}
