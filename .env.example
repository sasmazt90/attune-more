# ==============================================================================
# ATTUNE.MORE - ÖRNEK ÇEVRE DEĞİŞKENLERİ (.env.example)
# Bu dosya şablondur. Gerçek anahtarları ASLA bu dosyaya yazmayın.
# ==============================================================================

# Uygulama Ayarları
APP_ENV=development
APP_NAME=attune-more
PORT=3000
API_PORT=8000

# Frontend (Next.js) Yapılandırması
NEXT_PUBLIC_APP_NAME="Attune.more"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_DEMO_MODE=true

# Araç Bağlamı (Vehicle Context)
VEHICLE_SIMULATOR_ENABLED=true
DEFAULT_VEHICLE_STATE="PARKED" # PARKED | DRIVING

# Local Storage / Veritabanı
SQLITE_DB_PATH="./data/togg_health_local.db"

# İsteğe Bağlı Harici AI / LLM Servisleri (Tanımlanmazsa yerel kural motoru çalışır)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
