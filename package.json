{
  "name": "togg-health-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Togg Akıllı Cihazları İçin Bütünleşik, Yapay Zekâ Destekli Önleyici Sağlık Platformu",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/vehicle-app run dev",
    "build": "npm --workspace=apps/vehicle-app run build",
    "start": "npm --workspace=apps/vehicle-app run start",
    "lint": "npm --workspace=apps/vehicle-app run lint",
    "typecheck": "npm --workspace=apps/vehicle-app run typecheck",
    "test:backend": "pytest tests/unit -v"
  },
  "keywords": [
    "togg",
    "automotive",
    "digital-health",
    "preventive-health",
    "vision-test",
    "skin-analysis",
    "mental-wellbeing",
    "care-agent"
  ],
  "author": "Togg Health MVP Team",
  "license": "UNLICENSED",
  "overrides": {
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "next@15.5.27": {
      "postcss": "8.5.28"
    }
  }
}
