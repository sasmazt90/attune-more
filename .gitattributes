# Preserve the exact upstream license bytes referenced by SHA256 notices.
third-party/skin-research/*.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
third-party/combined-health/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
services/core-api/skin_scan_baseline/* -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Preserve the exact training program registered in the model provenance.
scripts/train_dental_yolox.py -text whitespace=cr-at-eol
# Local runtime/speech manifests refer to exact upstream or generated bytes.
# Windows checkout must not rewrite JS, task or audio line endings.
apps/vehicle-app/public/mediapipe/** -text
apps/vehicle-app/public/mediapipe/manifest.json whitespace=cr-at-eol
apps/vehicle-app/public/mediapipe/wasm/*.js whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
third-party/skin-focused/*.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
apps/vehicle-app/public/audio/vision-speech/** -text
apps/vehicle-app/public/audio/vision-speech/manifest.json whitespace=cr-at-eol
# User-pinned model/head/parity hashes identify exact package bytes on every OS.
services/core-api/models/dryness-calibrated-v3/** -text whitespace=cr-at-eol
# Vendored package manifests pin exact bytes, including upstream license/source.
vendor/braces/** -text whitespace=cr-at-eol
vendor/*.tgz -text

# Historical Skin evidence and model parameters are hashed as raw bytes.
# Prevent Windows core.autocrlf from rewriting their committed LF bytes on checkout.
docs/skin/evidence/** -text
services/core-api/models/regional-skin-v3/params.json -text

# Approved audio evidence pins raw manifest bytes on Windows too.
apps/vehicle-app/public/audio/guidance/manifest.json -text
apps/vehicle-app/public/audio/hearing-bank/instructions.json -text
apps/vehicle-app/public/audio/hearing-bank/manifest.json -text
apps/vehicle-app/public/audio/mental/v1/manifest.json -text
docs/mental-structured/listening/README.md -text
docs/mental-structured/listening/index.json -text
apps/vehicle-app/public/audio/localized/v1/en/hearing/manifest.json -text
apps/vehicle-app/public/audio/localized/v1/de/hearing/manifest.json -text
